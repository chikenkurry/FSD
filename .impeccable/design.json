      "kind": "button",
      "refersTo": "button-primary",
      "description": "Green action for the next concrete task.",
      "html": "<button class=\"ds-btn-primary\">Create form<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-btn-primary{font-family:'Public Sans',sans-serif;cursor:pointer;min-height:44px;padding:10px 16px;border:1px solid var(--control-line, #809387);border-radius:7px;background:var(--surface, #fff);color:var(--ink, #243440);font-size:15px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:8px;line-height:1.4;white-space:normal;transition:background-color 160ms ease-out,border-color 160ms ease-out}.ds-btn-primary:hover:not(:disabled){background:#edf1ed;border-color:#83988b}.ds-btn-primary:active:not(:disabled){background:#e0e9e2}.ds-btn-primary{background:var(--accent, #24614e);border-color:var(--accent, #24614e);color:#fff}.ds-btn-primary:hover:not(:disabled),.ds-btn-primary:active:not(:disabled){background:var(--accent-hover, #194b3b);border-color:var(--accent-hover, #194b3b)}.ds-btn-primary:disabled{cursor:not-allowed;background:#e7ebe7;border-color:#d4dcd5;color:#64716a}.ds-btn-primary:focus-visible{outline:3px solid var(--focus, #c17828);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-btn-primary{transition:none}}"
    },
