# Direct/local Decision process only. Compose uses FSD/.env instead.
# From FSD/: python3.12 -m decision_service.service --env-file decision_service/.env --role all
# Install decision_service/requirements.txt for PostgreSQL support.
PORT=8000
PLANNING_BASE_URL=http://localhost:8080
PARTICIPATION_BASE_URL=http://localhost:3000
INTERNAL_API_TOKEN=local-integration-token-change-me
DECISION_DB_PATH=./.local-data/runs.sqlite
# Set a reachable, dedicated PostgreSQL database for split API/worker processes.
# Then run --role migrate once before starting --role api / --role worker.
# A blank URL keeps the SQLite fallback for local standalone work.
DECISION_DATABASE_URL=
DECISION_DB_POOL_SIZE=8
DECISION_WORKERS=2
DECISION_JOB_TIMEOUT_SECONDS=180
DECISION_LEASE_SECONDS=300
SEMANTIC_PROVIDER=rules
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
SEMANTIC_MODEL_REVISION=qwen3-4b-instruct-v1
GEMINI_API_KEY=
GEMINI_FACT_MODEL=gemini-3.8-flash
