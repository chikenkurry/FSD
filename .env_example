# Copy this file to .env in FSD/. Docker Compose loads it automatically.
# Never commit .env or share API keys.

# Gemini: option research, drafted questions and web fact collection.
GEMINI_API_KEY=
GEMINI_FACT_MODEL=gemini-3.8-flash

# Use a long random secret shared by the three internal services.
# This example value is suitable only for the local development stack.
INTERNAL_API_TOKEN=local-integration-token-change-me

# Google Places API (New): venue photos, ratings, review summaries and addresses.
# Optional. Without it, venues are described from web search and show no photos.
# Restrict the key to the Places API and set a daily quota in Google Cloud Console.
GOOGLE_PLACES_API_KEY=

# Interpretation of member answers uses Ollama by default.
# Start Ollama separately with OLLAMA_MODEL installed; Compose connects to the host.
# Set rules explicitly for model-free operation. Gemini fact collection is separate.
SEMANTIC_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Change this when replacing model weights under the same model name.
SEMANTIC_MODEL_REVISION=qwen3-4b-instruct-v1

# Slots per recommendation/fact worker process (1-8).
DECISION_WORKERS=2
# Preview workers have reserved capacity in their own process.
DECISION_PREVIEW_WORKERS=1
# Research slots; each option is researched in parallel (1-8).
DECISION_RESEARCH_WORKERS=6
DECISION_JOB_TIMEOUT_SECONDS=180
# Lost-worker recovery lease. Heartbeats renew it during execution.
DECISION_LEASE_SECONDS=300
# Maximum database connections per API/worker process (1-32).
DECISION_DB_POOL_SIZE=8
