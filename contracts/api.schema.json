{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:what2do:api-v1",
  "$defs": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable",
        "requestId"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "requestId": {
          "type": "string"
        },
        "fieldErrors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "message"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "input_refs": {
      "type": "object",
      "required": [
        "plan_id",
        "round_id",
        "option_revision",
        "option_snapshot_id",
        "response_snapshot_id"
      ],
      "properties": {
        "plan_id": {
          "type": "string"
        },
        "round_id": {
          "type": "string"
        },
        "option_revision": {
          "type": "integer",
          "minimum": 1
        },
        "option_snapshot_id": {
          "type": "string"
        },
        "response_snapshot_id": {
          "type": "string"
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "status",
        "job_state",
        "input_refs",
        "issues"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "failed",
            "ranked",
            "blocked",
            "no_feasible_candidate",
            "needs_information",
            "needs_clarification",
            "unsupported",
            "invalid_input",
            "ready",
            "provisional",
            "needs_review"
          ]
        },
        "job_state": {
          "enum": [
            "queued",
            "running",
            "completed",
            "failed"
          ]
        },
        "input_refs": {
          "$ref": "#/$defs/input_refs"
        },
        "issues": {
          "type": "array"
        },
        "execution_specification": {
          "type": "object"
        },
        "result": {
          "type": "object"
        },
        "collection": {
          "type": "object"
        }
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "round_id",
        "plan_id",
        "selection_version",
        "run_id",
        "candidate_id",
        "option_snapshot_id",
        "response_snapshot_id",
        "selected_details",
        "confirmed_by",
        "confirmed_at"
      ],
      "properties": {
        "selection_version": {
          "type": "integer",
          "minimum": 1
        },
        "selected_details": {
          "type": "object"
        },
        "round_id": {
          "type": "string"
        },
        "plan_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "candidate_id": {
          "type": "string"
        },
        "option_snapshot_id": {
          "type": "string"
        },
        "response_snapshot_id": {
          "type": "string"
        },
        "confirmed_by": {
          "type": "string"
        },
        "confirmed_at": {
          "type": "string"
        }
      }
    },
    "preview_request": {
      "type": "object",
      "required": [
        "expected_revision"
      ],
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "retry": {
          "type": "boolean"
        }
      }
    },
    "rsvp_request": {
      "type": "object",
      "required": [
        "selectionVersion",
        "expectedRevision",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "selectionVersion": {
          "type": "integer",
          "minimum": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "GOING",
            "MAYBE",
            "DECLINED"
          ]
        }
      }
    },
    "fact_request": {
      "type": "object",
      "required": [
        "option_id",
        "attribute_id",
        "value_type"
      ],
      "properties": {
        "option_id": {
          "type": "string"
        },
        "attribute_id": {
          "type": "string"
        },
        "value_type": {
          "enum": [
            "number",
            "decimal",
            "boolean",
            "category",
            "tag_set"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "accept_facts_request": {
      "type": "object",
      "required": [
        "operation_id",
        "collection_run_id",
        "claim_ids",
        "reviewed"
      ],
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "collection_run_id": {
          "type": "string",
          "format": "uuid"
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "reviewed": {
          "const": true
        },
        "replace_existing": {
          "type": "boolean"
        }
      }
    }
  }
}
