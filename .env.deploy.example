# Copy to .env.deploy before running scripts/deploy.ps1.
# This file is for the temporary local deployment demonstration only.

# Replace this placeholder with a random value of at least 16 characters.
INTERNAL_API_TOKEN=replace-with-a-long-random-token

# Rules mode keeps the CI/CD proof of concept independent of Ollama and API keys.
# Change to ollama after the baseline deployment works.
SEMANTIC_PROVIDER=rules
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct
SEMANTIC_MODEL_REVISION=qwen3-4b-instruct-v1

# Keep the demonstration private to this laptop.
FRONTEND_BIND=127.0.0.1

# Optional provider integrations.
GEMINI_API_KEY=
GEMINI_FACT_MODEL=gemini-3.8-flash
GOOGLE_PLACES_API_KEY=

DECISION_WORKERS=2
DECISION_PREVIEW_WORKERS=1
DECISION_RESEARCH_WORKERS=2
DECISION_JOB_TIMEOUT_SECONDS=180
DECISION_LEASE_SECONDS=300
DECISION_DB_POOL_SIZE=8
